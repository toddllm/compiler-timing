 import types
 import importlib
 
+# --- F3 fix: define _autoload() before top-level `import torch` below. ---
+# torch >= 2.6 fires _import_device_backends() during `import torch`, which
+# resolves this module's registered entry point (torch_spyre:_autoload) via
+# importlib.metadata's getattr. Without this early definition, that getattr
+# hits a partially-initialized module. The early _autoload() defers: it
+# records that autoload was requested; if _autoload_impl isn't defined yet
+# (because we're still mid-init), it just returns. The real invocation
+# happens at the bottom of this __init__.py, where _autoload_impl is bound.
+import sys as _sys_for_autoload
+import traceback as _traceback_for_autoload
+
+def _autoload():
+    if getattr(_autoload, "_ran", False):
+        return
+    impl = globals().get("_autoload_impl")
+    if impl is None:
+        # Called during our own `import torch` -- rest of module not yet
+        # executed. Mark that autoload was requested and return; the tail
+        # of this __init__.py will invoke us again when everything is ready.
+        _autoload._requested = True
+        return
+    _autoload._ran = True
+    try:
+        impl()
+    except BaseException:
+        print(
+            "torch_spyre backend autoload failed; underlying error follows:",
+            file=_sys_for_autoload.stderr,
+        )
+        _traceback_for_autoload.print_exc()
+        raise
+
