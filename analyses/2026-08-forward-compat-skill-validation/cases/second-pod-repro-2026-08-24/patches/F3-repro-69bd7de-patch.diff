+# initialized. The real _autoload_impl is defined later in this
+# module; if it isn't bound yet when _autoload fires (the reverse-
+# entrypoint hazard), we record that autoload was requested and
+# return; the tail-invoke below runs it once the module is fully
+# loaded. If _autoload_impl IS already bound (later re-entrant
+# call, or a re-import), it dispatches through.
+import importlib as _importlib_for_autoload
+import sys as _sys_for_autoload
+import traceback as _traceback_for_autoload
+
+
+def _autoload():
+    if getattr(_autoload, "_ran", False):
+        return
+    _impl = globals().get("_autoload_impl")
+    if _impl is None:
+        _autoload._requested = True
+        return
+    _autoload._ran = True
+    try:
+        _impl()
+    except BaseException:
+        print(
+            "torch_spyre backend autoload failed; underlying error follows:",
+            file=_sys_for_autoload.stderr,
+        )
+        _traceback_for_autoload.print_exc()
+        raise
+
